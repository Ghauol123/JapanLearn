@page "/timkiem"
@model SearchModel
@{
    ViewData["Title"] = "Tìm kiếm";
    ViewData["HeaderSearch"] = false;
}
<header class="page-head">
    <p class="eyebrow">Tìm kiếm</p>
    <form method="get" role="search" class="hero-search">
        <input name="q" value="@Model.Query" type="search" class="form-control form-control-lg"
               placeholder="Tìm mẫu ngữ pháp, từ nối, nghĩa tiếng Việt hoặc câu ví dụ…" aria-label="Tìm kiếm" autofocus />
    </form>
</header>
<partial name="_SearchResults" model="Model.Results" />
