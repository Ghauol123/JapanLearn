{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "japanlearn",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-12",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "containers": [
    {
      "class_name": "WebContainer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WEB",
        "class_name": "WebContainer"
      }
    ]
  },
  "exports": {
    "WebContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "previews": {
    "containers": [
      {
        "class_name": "WebContainer",
        "image": "./Dockerfile",
        "instance_type": "basic",
        "max_instances": 1
      }
    ],
    "durable_objects": {
      "bindings": [
        {
          "name": "WEB",
          "class_name": "WebContainer"
        }
      ]
    }
  }
}
